[Unit]
Description=Native Wasm version-history server
After=network.target

[Service]
Type=simple
User=wasm-git
Group=wasm-git
ExecStart=/usr/local/bin/wasm-git-server --root /srv/wasm-git --listen 127.0.0.1:9419 --token-file /etc/wasm-git/token --allow-write
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/wasm-git

[Install]
WantedBy=multi-user.target
